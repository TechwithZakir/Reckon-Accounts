{
 "doctype": "DocType",
 "name": "Office Expense",
 "module": "Reckon Accounts",
 "autoname": "naming_series:",
 "naming_rule": "By script",
 "is_submittable": 1,
 "field_order": [
  "naming_series",
  "company",
  "posting_date",
  "payment_method",
  "cost_center",
  "project",
  "column_break_1",
  "payee",
  "reference_no",
  "reference_date",
