   "reqd": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Expense Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "payment_method",
   "fieldtype": "Link",
   "label": "Paid By",
   "options": "Mode of Payment",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "cost_center",
   "fieldtype": "Link",
